{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dearby.example/contracts/activities/1.0.0/schema.json",
  "title": "Dearby source-reviewed activity samples",
  "description": "조직·공고 분리, 근거와 불확실성을 보존하는 공고 규격 v1. 실제 개인별 추천 응답이 아닌 샘플 자료집.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "enum": [
        "1.0.0"
      ]
    },
    "mode": {
      "enum": [
        "reviewed_sample"
      ]
    },
    "snapshotAt": {
      "type": "string",
      "format": "date-time"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "organizations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/organization"
      }
    },
    "activities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/activity"
      }
    }
  },
  "required": [
    "schemaVersion",
    "mode",
    "snapshotAt",
    "sources",
    "organizations",
    "activities"
  ],
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sourceId": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "sourceId",
        "locator"
      ]
    },
    "rule": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "all": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/rule"
              }
            }
          },
          "required": [
            "all"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "any": {
              "type": "array",
              "minItems": 1,
              "items": {
                "$ref": "#/$defs/rule"
              }
            }
          },
          "required": [
            "any"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "someMember": {
              "$ref": "#/$defs/rule"
            }
          },
          "required": [
            "someMember"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "field": {
              "enum": [
                "applicant.hasCompletedTargetEnglishCourse",
                "applicant.year",
                "team.size",
                "team.division",
                "member.schoolRegion",
                "member.residenceRegion"
              ]
            },
            "operator": {
              "enum": [
                "eq",
                "lte",
                "in"
              ]
            },
            "value": {
              "type": [
                "string",
                "number",
                "boolean",
                "array"
              ],
              "items": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              }
            }
          },
          "required": [
            "field",
            "operator",
            "value"
          ]
        }
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "kind": {
          "enum": [
            "web_page",
            "poster",
            "attachment"
          ]
        },
        "checkedAt": {
          "type": "string",
          "format": "date-time"
        },
        "access": {
          "enum": [
            "public",
            "login_required",
            "unavailable"
          ]
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "url",
        "kind",
        "checkedAt",
        "access",
        "note"
      ]
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "department",
            "institution",
            "company",
            "community",
            "program"
          ]
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "parentOrganizationId": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "description": "상위 조직 ID. null은 이 자료에서 확인된 상위 조직이 없음을 뜻한다. 자기 참조와 순환은 허용하지 않는다."
        }
      },
      "required": [
        "id",
        "name",
        "kind",
        "sourceIds",
        "parentOrganizationId"
      ]
    },
    "audience": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "known",
            "partial",
            "unknown",
            "conflicting",
            "not_applicable"
          ]
        },
        "educationLevels": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "years": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "majors": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "institutionIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "summary",
        "status",
        "educationLevels",
        "years",
        "majors",
        "institutionIds",
        "evidence"
      ]
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "known",
            "partial",
            "unknown",
            "conflicting",
            "not_applicable"
          ]
        },
        "rule": {
          "anyOf": [
            {
              "$ref": "#/$defs/rule"
            },
            {
              "type": "null"
            }
          ]
        },
        "unknowns": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string",
                "minLength": 1
              },
              "reason": {
                "enum": [
                  "not_stated",
                  "attachment_not_reviewed",
                  "profile_missing"
                ]
              },
              "resolveBy": {
                "enum": [
                  "source_review",
                  "user_input"
                ]
              }
            },
            "required": [
              "field",
              "reason",
              "resolveBy"
            ]
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "summary",
        "status",
        "rule",
        "unknowns",
        "evidence"
      ]
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "opensOn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "opensAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "closesAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "closesOn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "deadlinePrecision": {
          "enum": [
            "date",
            "minute",
            "unknown"
          ]
        },
        "originalDeadline": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "enum": [
            "Asia/Seoul"
          ]
        },
        "channels": {
          "type": "array",
          "items": {
            "enum": [
              "office",
              "email",
              "postal",
              "platform",
              "external_form"
            ]
          }
        },
        "requiredDocuments": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "submissionLocations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "url": {
          "description": "확인된 웹 링크. 생략/null은 미확인. 원문 URL을 신청/온라인 링크로 자동 간주하지 않는다.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            }
          ]
        }
      },
      "required": [
        "summary",
        "opensOn",
        "opensAt",
        "closesAt",
        "closesOn",
        "deadlinePrecision",
        "originalDeadline",
        "timezone",
        "channels",
        "requiredDocuments",
        "submissionLocations",
        "evidence"
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "phase": {
          "type": "string",
          "minLength": 1
        },
        "startsOn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "startsAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "endsAt": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "mode": {
          "enum": [
            "online",
            "offline",
            "mixed",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "onlineUrl": {
          "description": "확인된 웹 링크. 생략/null은 미확인. 원문 URL을 신청/온라인 링크로 자동 간주하지 않는다.",
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "uri",
              "pattern": "^https?://"
            }
          ]
        },
        "endsOn": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "시각이 없는 활동 종료일(해당 날짜 포함)."
        },
        "timezone": {
          "enum": [
            "Asia/Seoul"
          ],
          "description": "시각/날짜의 기준 시간대. 기존 생략 자료는 Asia/Seoul로 해석."
        }
      },
      "required": [
        "phase",
        "startsOn",
        "startsAt",
        "endsAt",
        "mode",
        "evidence"
      ]
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "known",
            "partial",
            "unknown",
            "conflicting",
            "not_applicable"
          ]
        },
        "mode": {
          "enum": [
            "online",
            "offline",
            "mixed",
            "unknown"
          ]
        },
        "venues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "phase": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "address": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "coordinates": {
                "description": "지도 표시용 WGS84 좌표. 생략/null은 미확인. 건물 대표점일 수 있으며 층·호실은 name/summary를 확인한다.",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "latitude": {
                        "type": "number",
                        "minimum": -90,
                        "maximum": 90
                      },
                      "longitude": {
                        "type": "number",
                        "minimum": -180,
                        "maximum": 180
                      }
                    },
                    "required": [
                      "latitude",
                      "longitude"
                    ]
                  }
                ]
              },
              "coordinateEvidence": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/evidence"
                },
                "description": "공식 지도 등 좌표와 장소 연결의 확인 근거."
              }
            },
            "required": [
              "phase",
              "name",
              "address"
            ]
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "summary",
        "status",
        "mode",
        "venues",
        "evidence"
      ]
    },
    "benefit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "external_mileage",
            "course_requirement_waiver",
            "gift",
            "other"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "issuer": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "kind",
        "summary",
        "amount",
        "unit",
        "issuer",
        "evidence"
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "fieldPath": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "resolveBy": {
          "enum": [
            "source_review",
            "editorial_review",
            "user_input"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      },
      "required": [
        "code",
        "fieldPath",
        "summary",
        "resolveBy",
        "evidence"
      ]
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "academic_administration",
            "competition",
            "career_event",
            "mentoring",
            "club_recruitment",
            "other"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "demoVisible": {
          "type": "boolean"
        },
        "sourceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "organizationLinks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "organizationId": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "publisher",
                  "submission_office",
                  "operator",
                  "subject",
                  "contact",
                  "host"
                ]
              }
            },
            "required": [
              "organizationId",
              "role"
            ]
          }
        },
        "favoriteOrganizationId": {
          "type": [
            "string",
            "null"
          ]
        },
        "interestTags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "audience": {
          "$ref": "#/$defs/audience"
        },
        "eligibility": {
          "$ref": "#/$defs/eligibility"
        },
        "application": {
          "$ref": "#/$defs/application"
        },
        "schedule": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/phase"
          }
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "benefits": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/benefit"
          }
        },
        "cost": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "amount": {
              "type": [
                "number",
                "null"
              ]
            },
            "currency": {
              "enum": [
                "KRW"
              ]
            },
            "status": {
              "enum": [
                "known",
                "partial",
                "unknown",
                "conflicting",
                "not_applicable"
              ]
            }
          },
          "required": [
            "amount",
            "currency",
            "status"
          ]
        },
        "capacity": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "qualityIssues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/issue"
          }
        },
        "edition": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "원문에 명시된 모집·행사 회차. 미확인 또는 해당 없으면 null."
        },
        "categoryPath": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "recruitment",
              "recruitment_event",
              "competition",
              "career",
              "mentoring",
              "academic_administration"
            ]
          }
        },
        "contexts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "organizationId": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "event_context",
                  "venue_institution",
                  "audience_institution",
                  "co_operator"
                ]
              },
              "basis": {
                "enum": [
                  "user_confirmed",
                  "source_reviewed"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "organizationId",
              "role",
              "basis",
              "note"
            ]
          }
        },
        "targetSelection": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "enum": [
                "user_approved",
                "editorial_provisional"
              ]
            },
            "ruleId": {
              "type": [
                "string",
                "null"
              ]
            },
            "note": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "method",
            "ruleId",
            "note"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "kind",
        "summary",
        "demoVisible",
        "sourceIds",
        "organizationLinks",
        "favoriteOrganizationId",
        "interestTags",
        "audience",
        "eligibility",
        "application",
        "schedule",
        "location",
        "benefits",
        "cost",
        "capacity",
        "qualityIssues",
        "edition",
        "categoryPath",
        "contexts",
        "targetSelection"
      ]
    }
  }
}
