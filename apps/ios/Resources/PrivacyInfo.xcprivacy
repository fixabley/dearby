<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- App-level privacy manifest: only what the app's own code and server collect or access. Firebase and the other SDKs ship their own
     manifests, so data only Firebase Analytics gathers (coarse location, diagnostics) is left to them. App Privacy answers: docs/store/listing-2026-10-25.md. -->
