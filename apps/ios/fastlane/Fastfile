# App Store submission (.github/workflows/ios-appstore-submit.yml). The binary is already on TestFlight; this lane only picks
# that build, uploads metadata/ko and screenshots/ko, and optionally submits for review. Credentials come from the environment.
default_platform(:ios)

platform :ios do
  desc "Attach a processed TestFlight build to the App Store version, upload the listing, optionally submit for review"
  lane :submit do
    api_key = app_store_connect_api_key(key_id: ENV.fetch("ASC_KEY_ID"), issuer_id: ENV.fetch("ASC_ISSUER_ID"),
                                        key_filepath: ENV.fetch("ASC_KEY_PATH"))
    version = ENV.fetch("APP_VERSION")
    build = ENV["BUILD_NUMBER"].to_s
    build = latest_testflight_build_number(version: version, api_key: api_key).to_s if build.empty?
    wait_for_processing(version, build)
    screenshots = Dir.glob(File.join(__dir__, "screenshots", "ko", "*.png")).any?
    deliver(
      api_key: api_key, platform: "ios", app_version: version, build_number: build,
      skip_binary_upload: true, skip_screenshots: !screenshots, overwrite_screenshots: true,
      submit_for_review: ENV["SUBMIT_FOR_REVIEW"] == "true", automatic_release: false, force: true,
      run_precheck_before_submit: false, precheck_include_in_app_purchases: false,
      # Info.plist already sets ITSAppUsesNonExemptEncryption=false; no advertising identifier.
      submission_information: { export_compliance_uses_encryption: false, add_id_info_uses_idfa: false }
    )
  end
end

# A just-uploaded build is not attachable until App Store Connect finishes processing it (often 5–30 minutes).
def wait_for_processing(version, build)
  app = Spaceship::ConnectAPI::App.find(CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier))
  40.times do
    state = app.get_builds(filter: { "preReleaseVersion.version" => version, version: build }).first&.processing_state
    return UI.success("Build #{version} (#{build}) is processed") if state == "VALID"
    UI.user_error!("Build #{version} (#{build}) is #{state}") if %w[FAILED INVALID].include?(state)
    UI.message("Waiting for build #{version} (#{build}): #{state || 'not visible yet'}")
    sleep 60
  end
  UI.user_error!("Build #{version} (#{build}) was not processed within 40 minutes")
end
