# Server only. Origin, without /v1. No Supabase credentials in this app.
DEARBY_API_ORIGIN=https://api.example.test
# Match the API deployment. Generate/provision outside Git; minimum 32 characters.
GUEST_PROXY_SECRET=
# App link association for /s/* (optional; each file returns 404 until its values are set).
# Apple Team ID (10 characters) and comma-separated bundle IDs.
DEARBY_APPLE_TEAM_ID=
DEARBY_IOS_BUNDLE_IDS=
# Android package and comma-separated SHA-256 signing certificate fingerprints (AA:BB:...).
DEARBY_ANDROID_PACKAGE=
DEARBY_ANDROID_CERT_SHA256=
