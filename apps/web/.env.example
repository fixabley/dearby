# Server only. Origin, without /v1.
DEARBY_API_ORIGIN=https://api.example.test
# Match the API deployment. Generate/provision outside Git; minimum 32 characters.
GUEST_PROXY_SECRET=
# 웹 로그인 (contract native-v1.md "웹 로그인"). Public ids, not secrets; an empty value hides that button.
# Apple Services ID (the web origin registered as its Return URL; also in the API's APPLE_CLIENT_IDS).
NEXT_PUBLIC_APPLE_SERVICES_ID=
# Apple JS redirectURI; set to the API's APPLE_CALLBACK_URL (https://api…/v1/auth/apple/callback) so the authorization code converts.
# Unset, the page origin is used and no code is sent.
NEXT_PUBLIC_APPLE_REDIRECT_URI=
# Google OAuth web client id (the web origin in its Authorized JavaScript origins; the same value as the API's GOOGLE_WEB_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
