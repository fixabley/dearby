<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
    <!-- Contract "모바일 실제 연결 경계": network only for the real-service scope (activities, sign-in, cards). -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Contract "기기 캘린더 겹침": requested only when 겹치는 시간 확인 is tapped; read-only, compared on device. -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>
    <!-- 새 모집 푸시 (contract "즐겨찾기(하트)·새 모집 푸시 알림"): Android 13+ asks once, at the first program heart, never at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 찜한 세션 이동 알림 (2026-10-26, device-local): exact alarms 10 minutes before a 찜한 세션 (Android 14+ grants SCHEDULE_EXACT_ALARM only when the
         user allows it in the system settings; without it the alarm is inexact) and setting them again after a reboot. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- 행사 당일 진행 중 알림 (2026-10-26, device-local): Android 16's live update (status bar chip, One UI 8 Now Bar) is granted per app with this
         normal permission, which the user can revoke in the notification settings; below Android 16 it is an ordinary ongoing notification. -->
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS"/>
    <!-- 맞춤 대기열 끝 광고 (2026-10-25): AdMob reads the advertising id (com.google.android.gms.permission.AD_ID, merged from the SDK) even for
         non-personalised ads, for frequency capping and fraud checks. 사용 통계 still never collects it (google_analytics_adid_collection_enabled).
         The Privacy Sandbox permissions the SDK and Firebase merge in (Topics is interest targeting, Attribution is measurement) stay removed. -->
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove"/>
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_TOPICS" tools:node="remove"/>
    <application android:label="Dearby" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:dataExtractionRules="@xml/data_extraction_rules" android:allowBackup="false" android:fullBackupContent="false" android:supportsRtl="true" android:theme="@style/Theme.Dearby" android:usesCleartextTraffic="false">
        <!-- singleTask: the dearby://auth/apple redirect must reach this instance (onNewIntent), which holds the verifier, and close the Custom Tab above it. -->
        <activity android:name=".app.MainActivity" android:exported="true" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.Dearby.Starting">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <!-- Apple sign-in's web flow returns here (contract "애플 로그인"); Google is native (no redirect). MainActivity accepts only ?code=<UUID> or ?error=cancelled|failed. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="dearby" android:host="auth" android:path="/apple"/>
            </intent-filter>
            <!-- GitHub 연결 (contract "연락처 인증", 2026-10-26): the API's callback sends the browser back to dearby://contacts/github?code=<UUID> or ?error=cancelled|failed;
                 the code is spent on POST /v1/me/contacts/github/complete with this account's Bearer (login and tokens never ride in the link). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="dearby" android:host="contacts" android:path="/github"/>
            </intent-filter>
            <!-- 명함 교환 (contract "명함 교환"): the web card page's "Dearby 앱에 저장" opens dearby://cards/<cardId>?activity=<n>. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="dearby" android:host="cards" android:pathPrefix="/"/>
            </intent-filter>
            <!-- `오늘 일정 n개` push (contract "프로그램·활동별 알림 수준"): dearby://favorites?view=calendar opens 즐겨찾기. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:scheme="dearby" android:host="favorites"/>
            </intent-filter>
            <!-- App Links (contract "유니버설 링크·App Links·활동 공유·오픈그래프"): only the web origin's /cards/* and /activities/* open the app;
                 the host comes from DEARBY_WEB_ORIGIN (build.gradle.kts), verified against the web's /.well-known/assetlinks.json. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https"/>
                <data android:host="${webHost}"/>
                <data android:pathPrefix="/cards/"/>
                <data android:pathPrefix="/activities/"/>
            </intent-filter>
        </activity>
        <!-- FCM (inert without google-services.json): background notifications land on the 새 모집 channel with the Dearby symbol. -->
        <service android:name=".features.push.DearbyMessagingService" android:exported="false">
            <intent-filter><action android:name="com.google.firebase.MESSAGING_EVENT"/></intent-filter>
        </service>
        <meta-data android:name="com.google.firebase.messaging.default_notification_channel_id" android:value="new_recruitment"/>
        <!-- 세션 이동 알림: the alarm's receiver (explicit intents from this app only) and the reboot/exact-alarm-allowed restore (system broadcasts). -->
        <receiver android:name=".features.reminder.SessionReminderReceiver" android:exported="false"/>
        <!-- 행사 진행 중: the redraw alarm's receiver (explicit intents from this app only); the reboot restore is the boot receiver below. -->
        <receiver android:name=".features.live.LiveSessionReceiver" android:exported="false"/>
        <receiver android:name=".app.SessionReminderBootReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED"/>
            </intent-filter>
        </receiver>
        <meta-data android:name="com.google.firebase.messaging.default_notification_icon" android:resource="@drawable/dearby_symbol"/>
        <!-- 2026-10-25 user decisions: no FCM token until the first program heart (Push.enable); Firebase Analytics without the advertising id,
             SSAID or ad personalisation (collection itself follows 설정 `사용 통계 보내기`, features/analytics). -->
        <!-- AdMob app id from ADMOB_ANDROID_APP_ID (build.gradle.kts); Google's test app id in Debug or when the release has none. -->
        <meta-data android:name="com.google.android.gms.ads.APPLICATION_ID" android:value="${adMobAppId}"/>
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false"/>
        <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false"/>
        <meta-data android:name="google_analytics_ssaid_collection_enabled" android:value="false"/>
        <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false"/>
    </application>
</manifest>
