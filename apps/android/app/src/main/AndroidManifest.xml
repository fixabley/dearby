<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:label="Dearby" android:icon="@drawable/ic_launcher" android:dataExtractionRules="@xml/data_extraction_rules" android:allowBackup="false" android:fullBackupContent="false" android:supportsRtl="true" android:theme="@style/Theme.Dearby" android:usesCleartextTraffic="false">
        <activity android:name=".app.MainActivity" android:exported="true">
            <intent-filter><action android:name="android.intent.action.MAIN"/><category android:name="android.intent.category.LAUNCHER"/></intent-filter>
            <!-- Shared-card App Links: https://<DEARBY_WEB_ORIGIN host>/s/<UUID>. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="${dearbyWebHost}" android:pathPrefix="/s/"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
