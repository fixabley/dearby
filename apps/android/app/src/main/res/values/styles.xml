<resources>
    <style name="Theme.Dearby" parent="android:style/Theme.Material.Light.NoActionBar"><item name="android:fontFamily">sans</item><item name="android:windowLightStatusBar">true</item></style>
    <!-- Launch splash: the Dearby logo on the app's white background, then Theme.Dearby. -->
    <style name="Theme.Dearby.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Dearby</item>
    </style>
</resources>
