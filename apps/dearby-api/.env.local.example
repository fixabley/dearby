# 로컬 개발용. cp .env.local.example .env.local 후 값을 채운다. .env.local은 Git에서 제외된다
# docker compose --env-file .env.local up -d 와 Spring local 프로필(application-local.yaml)이 같은 값을 함께 읽는다
# 운영은 .env.prod.example 참고

DB_HOST=localhost
DB_PORT=5432
DB_NAME=dearby
DB_USERNAME=dearby
DB_PASSWORD=

# JWT 서명용 RSA 개인키. 없으면 기동 시 생성
JWT_KEY_PATH=data/jwt/private.pem

# 패스키·토큰 도메인. 브라우저는 http://localhost 에서만 패스키를 허용한다
# 여기서 등록한 패스키는 운영 도메인에서 쓸 수 없다
# WEBAUTHN_ALLOWED_ORIGINS(쉼표 구분)에는 패스키 요청을 보내는 쪽의 origin을 넣는다
#   웹: 브라우저 origin (예: http://localhost:3000), 어드민 웹: http://localhost:5173
#   iOS 앱: https://<RP ID>  (운영은 https://wid.io.kr)
#   Android 앱: android:apk-key-hash:<앱 서명 인증서 SHA-256의 base64url, 패딩 없음>
# 앱 패스키는 RP ID 도메인의 apple-app-site-association·assetlinks.json이 필요해 localhost에서는 쓸 수 없다
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080
JWT_ISSUER=http://localhost:8080

# 연락처 인증(선택, native-v1.md "연락처 인증"). 비우면 그 기능만 503
# GitHub: github.com > Settings > Developer settings > OAuth Apps. 로컬용 OAuth App의 Authorization callback URL은 http://localhost:8080/v1/me/contacts/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/v1/me/contacts/github/callback
GITHUB_WEB_REDIRECT_URI=http://localhost:3000/profile
# 이메일 인증번호(Spring Mail). 로컬은 mailpit(docker run -p 1025:1025 -p 8025:8025 axllent/mailpit)에 보내고 http://localhost:8025 에서 본다
MAIL_HOST=
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=Dearby <no-reply@localhost>
MAIL_STARTTLS=false

# 활동 수집(batch)은 Claude Code CLI(구독)로 돈다. 로컬 Mac은 claude 로그인만으로 되고, 컨테이너는 `claude setup-token`으로 만든 토큰을 넣는다
CLAUDE_CODE_OAUTH_TOKEN=
