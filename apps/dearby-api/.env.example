# Local single-process runtime; keep this directory private (umask 077).
HOST=127.0.0.1
PORT=3000
DATABASE_PATH=./var/dearby.sqlite
# Generate independently: openssl rand -hex 32. Required, never commit real value.
OTP_SECRET=
# Absent SMTP configuration deliberately returns 503, never a fake sent result.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# TLS is mandatory. Port 465 uses implicit TLS; other ports require STARTTLS.
