# 운영용. cp .env.prod.example .env.prod 후 값을 채운다. .env.prod는 Git에서 제외된다
# docker compose -f compose.prod.yaml --env-file .env.prod up -d --build
DB_NAME=dearby
DB_USERNAME=dearby
DB_PASSWORD=
# nginx가 프록시할 호스트 포트(127.0.0.1에만 열림). 로컬 bootRun(8080)·기존 TS API(58865)와 겹치지 않게 둔다
API_PORT=58866
# DB를 이 서버에서 직접 볼 때 쓰는 호스트 포트(127.0.0.1에만 열림). 로컬 DB(5432)와 겹치지 않게 둔다
DB_PUBLISH_PORT=58867
# 관리자 API 호스트 포트(127.0.0.1에만 열림). nginx가 /v1/admin/ 을 보낸다
ADMIN_PORT=58868

# 패스키·토큰 도메인. WEBAUTHN_RP_ID를 바꾸면 등록된 패스키를 모두 쓸 수 없게 된다
# WEBAUTHN_ALLOWED_ORIGINS(쉼표 구분)에는 패스키 요청을 보내는 쪽의 origin을 넣는다
#   웹: https://dearby.wid.io.kr
#   어드민 웹: https://admin.dearby.wid.io.kr
#   iOS 앱: https://wid.io.kr
#   Android 앱: android:apk-key-hash:<배포 서명 인증서 SHA-256의 base64url, 패딩 없음>
#     (keytool로 본 SHA-256 콜론 hex를 바이트로 바꿔 base64url 인코딩. 실제 값을 확인한 뒤 뒤에 추가한다)
WEBAUTHN_RP_ID=wid.io.kr
WEBAUTHN_ALLOWED_ORIGINS=https://dearby.wid.io.kr,https://admin.dearby.wid.io.kr,https://wid.io.kr
JWT_ISSUER=https://dearby.wid.io.kr

# 애플 로그인(선택). 비우면 애플 로그인만 503. 값은 비밀이 아니다
# APPLE_CLIENT_IDS: identity token의 aud로 받을 값(쉼표 구분) = iOS 번들 ID, Services ID
APPLE_CLIENT_IDS=io.wid.dearby,<Services ID>
APPLE_SERVICES_ID=<Services ID>
APPLE_CALLBACK_URL=https://api.dearby.wid.io.kr/v1/auth/apple/callback

# 활동 수집(batch) 엔진. api: Claude API(ANTHROPIC_API_KEY, 사용량 과금), cli: Claude Code CLI(구독)
COLLECTION_ENGINE=api
ANTHROPIC_API_KEY=
# cli 엔진 인증. 로컬 Mac은 claude 로그인만으로 되고, 컨테이너는 `claude setup-token`으로 만든 토큰을 넣는다
CLAUDE_CODE_OAUTH_TOKEN=
