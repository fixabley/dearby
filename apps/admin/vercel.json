{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": { "deploymentEnabled": { "**": false, "main": true } },
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "ignoreCommand": "git diff --quiet \"${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}\" HEAD -- .",
  "rewrites": [
    { "source": "/api/auth/:path*", "destination": "https://api.dearby.wid.io.kr/v1/auth/:path*" },
    { "source": "/api/admin/:path*", "destination": "https://api.dearby.wid.io.kr/v1/admin/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
